{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/skills/writing-harness/scripts/cards.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
